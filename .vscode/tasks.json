{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "filenode: Windows desktop",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-windows.ps1"],
      "dependsOn": ["filenode: prepare debug profile"],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "filenode: Rust Windows",
      "type": "process", "command": "cargo",
      "args": ["build", "--locked", "--target", "x86_64-pc-windows-msvc"],
      "dependsOn": ["filenode: prepare debug profile"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "filenode: Linux desktop",
      "type": "process", "command": "sh",
      "args": ["${workspaceFolder}/scripts/build-linux.sh"],
      "dependsOn": ["filenode: prepare debug profile"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "filenode: prepare debug profile",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/scripts/prepare-debug.sh"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/prepare-debug.ps1"]
      },
      "problemMatcher": []
    },
    {
      "label": "filenode: build",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--locked"],
      "problemMatcher": ["$rustc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "filenode: tests",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--locked", "--all-targets"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "filenode: clippy",
      "type": "process",
      "command": "cargo",
      "args": ["clippy", "--locked", "--all-targets", "--", "-D", "warnings"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
