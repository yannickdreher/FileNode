{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FileNode: Windows existing build (no Cargo required)",
      "type": "coreclr", "request": "launch",
      "program": "${workspaceFolder}/.dev/filenode-preview/filenode-ui.exe",
      "args": ["--config", "${workspaceFolder}/.dev/profile.toml", "--settings"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "filenode: prepare debug profile"
    },
    {
      "name": "FileNode: Windows WinUI (Microsoft C# debugger)",
      "type": "coreclr", "request": "launch",
      "program": "${workspaceFolder}/apps/windows/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64/filenode-ui.exe",
      "args": ["--config", "${workspaceFolder}/.dev/profile.toml", "--settings"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "filenode: Windows desktop"
    },
    {
      "name": "FileNode: Rust core Windows (Microsoft debugger)",
      "type": "cppvsdbg", "request": "launch",
      "program": "${workspaceFolder}/target/x86_64-pc-windows-msvc/debug/filenode.exe",
      "args": ["--headless", "--once", "--config", "${workspaceFolder}/.dev/profile.toml"],
      "cwd": "${workspaceFolder}", "preLaunchTask": "filenode: Rust Windows",
      "environment": [{"name": "RUST_BACKTRACE", "value": "1"}]
    },
    {
      "name": "FileNode: Linux KDE (GDB)",
      "type": "cppdbg", "request": "launch",
      "program": "${workspaceFolder}/target/debug/filenode-kde",
      "args": ["--config", "${workspaceFolder}/.dev/profile.toml", "--settings", "--no-tray"],
      "cwd": "${workspaceFolder}", "MIMode": "gdb",
      "preLaunchTask": "filenode: Linux desktop"
    },
    {
      "name": "FileNode: Rust core Linux (GDB)",
      "type": "cppdbg", "request": "launch",
      "program": "${workspaceFolder}/target/debug/filenode",
      "args": ["--headless", "--once", "--config", "${workspaceFolder}/.dev/profile.toml"],
      "cwd": "${workspaceFolder}", "MIMode": "gdb",
      "preLaunchTask": "filenode: build"
    }
  ]
}
