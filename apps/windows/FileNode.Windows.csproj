<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FileNode.Windows</RootNamespace>
    <AssemblyName>filenode-ui</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(PackageForStore)' != 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <ApplicationIcon>Assets\filenode.ico</ApplicationIcon>
    <RustCorePath Condition="'$(RustCorePath)' == ''">$(MSBuildThisFileDirectory)..\..\target\debug\filenode.exe</RustCorePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RustCorePath)" Link="filenode-core.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RustCorePath)')" />
  </ItemGroup>
  <Target Name="ValidateXamlOutputPath" BeforeTargets="Prep_ComputeProcessXamlFiles">
    <!-- WinUI concatenates OutputPath and App.xbf without inserting a separator.
         dotnet build -o may supply a path without the trailing separator. -->
    <PropertyGroup>
      <_FileNodeXamlOutputPath>$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</_FileNodeXamlOutputPath>
    </PropertyGroup>
    <Error Condition="'$(OutputPath)' != '$(_FileNodeXamlOutputPath)'" Text="WinUI OutputPath must end with a directory separator to package App.xbf correctly. Use scripts/build-windows.ps1 -OutputDirectory or supply a trailing slash." />
  </Target>
  <Target Name="RequireCoreForPackage" BeforeTargets="Build" Condition="'$(PackageForStore)' == 'true' And !Exists('$(RustCorePath)')">
    <Error Text="Build the matching Rust core first and set RustCorePath. A Store package must contain the sync executable." />
  </Target>
</Project>
